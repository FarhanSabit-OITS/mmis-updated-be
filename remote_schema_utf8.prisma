// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  // Remove previewFeatures unless you really need one that exists in v6
  // previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // <-- UNCOMMENT / ADD THIS LINE
  // If you want Postgres extensions (optional; see note below), keep this:
  // extensions = [citext(), pg_trgm()]
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
  DELETED
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
}

enum AdminLevel {
  SUPER_ADMIN
  NATIONAL_ADMIN
  DISTRICT_ADMIN
  CITY_ADMIN
  MARKET_MASTER
  PSEUDO_MARKET_ADMIN
}

enum PseudoMarketRole {
  REVENUE_COLLECTOR
  HEALTH_INSPECTOR
  SECURITY_ADMIN
  GATE_COUNTER
  STOCK_COUNTER
  VAT_PAYMENT_COUNTER
  WAREHOUSE_MANAGER
  QUALITY_CONTROLLER
}

enum StakeholderType {
  MARKET_AUTHORITY
  MEMBER
  VENDOR
  SUPPLIER
  CUSTOMER
  GUEST
}

enum MfaType {
  EMAIL
  SMS
  TOTP
  NONE
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  PASSWORD_RESET
  ACCOUNT_RECOVERY
  ADMIN_INVITATION
  KYC_VERIFICATION
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
  USED
}

enum InvitationType {
  ADMIN_ONBOARDING
  VENDOR_REGISTRATION
  SUPPLIER_REGISTRATION
  USER_REGISTRATION
  KYC_VERIFICATION
  PASSWORD_RESET
}

enum PermissionResource {
  SYSTEM
  USER
  MARKET
  CITY
  DISTRICT
  SHOP
  STALL
  PRODUCT
  INVENTORY
  GATE
  PAYMENT
  TAX
  REPORT
  SETTINGS
  KYC
  INVITATION
  ROLE
  PERMISSION
  DOCUMENT
  AUDIT
  NOTIFICATION
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  MANAGE
  APPROVE
  VERIFY
  EXPORT
  IMPORT
  ASSIGN
  REVOKE
}

enum DocumentType {
  ID_PROOF
  ADDRESS_PROOF
  BUSINESS_LICENSE
  TAX_REGISTRATION
  BANK_STATEMENT
  UTILITY_BILL
  PASSPORT
  DRIVING_LICENSE
  VENDOR_CERTIFICATE
  SUPPLIER_CERTIFICATE
  QUALITY_CERTIFICATE
  INSURANCE_POLICY
  OTHER
}

enum MarketType {
  PERMANENT
  TEMPORARY
  POP_UP
  WEEKLY_BAZAAR
  SEASONAL
}

enum ShopType {
  RETAIL
  WHOLESALE
  SERVICE
  FOOD
  ELECTRONICS
  CLOTHING
  FURNITURE
  JEWELRY
  PHARMACY
  STATIONERY
  OTHER
}

enum StallType {
  PERMANENT
  TEMPORARY
  SEASONAL
  POP_UP
  KIOSK
}

enum MarketTokenType {
  GATE_ENTRY
  GATE_EXIT
  STOCK_RECEIPT
  STOCK_DISPATCH
  PAYMENT_CONFIRMATION
  TAX_PAYMENT
  RENT_PAYMENT
  INSPECTION_APPROVAL
  DELIVERY_CONFIRMATION
  VEHICLE_PASS
  VISITOR_PASS
  TEMPORARY_ACCESS
}

enum TokenStatus {
  PENDING
  ACTIVE
  USED
  EXPIRED
  REVOKED
  INVALIDATED
}

enum QrCodeType {
  USER_IDENTIFICATION
  STAFF_IDENTIFICATION
  VEHICLE_PASS
  PRODUCT_TRACKING
  PAYMENT_RECEIPT
  GATE_PASS
  DELIVERY_CONFIRMATION
  INSPECTION_TAG
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

/**
 * ************
 * CORE USER & AUTH
 * ************
 */
model User {
  id           String  @id @default(uuid())
  email        String  @unique @db.VarChar(255)
  passwordHash String  @db.VarChar(255)
  phone        String? @unique @db.VarChar(20)

  mfaEnabled      Boolean   @default(false)
  mfaType         MfaType   @default(NONE)
  totpSecret      String?   @db.VarChar(255)
  totpBackupCodes String[] // Array ΓÇö length enforced in app layer
  lastTotpUsed    DateTime?

  emailVerified             Boolean   @default(false)
  phoneVerified             Boolean   @default(false)
  lastEmailVerificationSent DateTime?
  lastPhoneVerificationSent DateTime?

  loginAttempts      Int       @default(0)
  lockUntil          DateTime?
  lastLogin          DateTime?
  lastPasswordChange DateTime?
  passwordHistory    String[] // history entries ΓÇö length enforced in app

  status             UserStatus @default(PENDING)
  deactivationReason String?    @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  profile     UserProfile?
  admin       Admin?
  stakeholder Stakeholder?

  verificationTokens VerificationToken[]
  marketTokens       MarketToken[]
  qrCodes            QrCode[]            @relation("UserQrCodes")
  sessions           UserSession[]

  userRoles UserRole[]

  auditLogs     AuditLog[]     @relation("UserAuditLogs")
  notifications Notification[]

  uploadedDocs   Document[]     @relation("DocumentUploader")
  uploadedAssets DigitalAsset[] @relation("AssetUploader")

  gateOperationsRecordedBy  GateOperation[] @relation("GateOperationRecordedBy")
  gateOperationsValidatedBy GateOperation[] @relation("GateOperationValidatedBy")

  dailyCollectionsAsCollector DailyCollection[] @relation("DailyCollectionCollector")
  dailyCollectionsAsCreator   DailyCollection[] @relation("DailyCollectionCreator")
  dailyCollectionsAsVerifier  DailyCollection[] @relation("DailyCollectionVerifier")

  createdLevels            MarketLevel[]   @relation("LevelCreatedBy")
  createdSections          MarketSection[] @relation("SectionCreatedBy")
  createdAisles            MarketAisle[]   @relation("AisleCreatedBy")
  createdShops             Shop[]          @relation("ShopCreatedBy")
  createdStalls            Stall[]         @relation("StallCreatedBy")
  createdGates             MarketGate[]    @relation("GateCreatedBy")
  createdTokens            MarketToken[]   @relation("TokenCreatedBy")
  createdQrCodes           QrCode[]        @relation("QrCodeCreatedBy")
  createdShopAssets        ShopAsset[]     @relation("ShopAssetCreatedBy")
  createdStallAssets       StallAsset[]    @relation("StallAssetCreatedBy")
  registeredScannerDevices ScannerDevice[] @relation("ScannerDeviceRegistrar")

  // Other Operation Relations
  createdGateEntries         GateEntry[]
  createdStockMovements      StockMovement[]
  createdTaxPayments         TaxPayment[]
  createdHealthInspections   HealthInspection[]
  createdMarketRegulations   MarketRegulation[]
  createdBusinessLicenses    BusinessLicense[]
  createdDeliveries          Delivery[]           @relation("DeliveryCreator") // Add this
  createdSupplierInvoices    SupplierInvoice[]
  createdProductReviews      ProductReview[]
  createdLoyaltyTransactions LoyaltyTransaction[]
  createdMarketTaxes         MarketTax[]

  // Add this new relation for verified deliveries
  verifiedDeliveries      Delivery[]              @relation("DeliveryVerifier")
  verifiedGuests          GuestEntry[]            @relation("GuestVerifier")
  CreatedGuests           GuestEntry[]            @relation("GuestCreator")
  createdTokenConfigs     TokenGenerationConfig[]
  createdQrConfigs        QrGenerationConfig[]
  tokenUsageLogs          TokenUsageLog[]         @relation("UserTokenUsageLogs")
  qrScanLogs              QrScanLog[]             @relation("UserQrScanLogs")
  sentInvitations         Invitation[]            @relation("InvitationSenderUser")
  acceptedInvitations     Invitation[]            @relation("InvitationAccepter")
  sponsoredGuests         Guest[]                 @relation("GuestSponsor")
  createdInventoryRecords InventoryRecord[]       @relation("InventoryRecordRecorder")
  createdSales            Sale[]                  @relation("SaleCreator")
  createdProducts         Product[]               @relation("ProductCreator")
  createdRentContract     RentContract[]          @relation("RentContractCreator")
  triggeredInvoiceRuns    InvoiceGenerationRun[]  @relation("InvoiceGenerationRunTriggerUser")

  @@index([email])
  @@index([phone])
  @@index([status])
  @@map("users")
}

model UserProfile {
  id     String @id @default(uuid())
  userId String @unique

  title       String?   @db.VarChar(10)
  firstName   String    @db.VarChar(100)
  middleName  String?   @db.VarChar(100)
  lastName    String    @db.VarChar(100)
  displayName String?   @db.VarChar(150)
  gender      Gender?
  dateOfBirth DateTime?
  age         Int?

  nationalId      String? @unique @db.VarChar(50)
  nationalIdType  String? @default("NIN") @db.VarChar(20)
  passportNumber  String? @unique @db.VarChar(50)
  passportCountry String? @db.VarChar(100)
  taxIdNumber     String? @unique @db.VarChar(50)

  primaryPhone     String  @db.VarChar(20)
  secondaryPhone   String? @db.VarChar(20)
  emergencyPhone   String? @db.VarChar(20)
  emergencyContact String? @db.VarChar(100)
  primaryEmail     String  @db.VarChar(255)
  secondaryEmail   String? @db.VarChar(255)

  residentialAddress String? @db.VarChar(500)
  permanentAddress   String? @db.VarChar(500)
  city               String? @db.VarChar(100)
  district           String? @db.VarChar(100)
  country            String  @default("Uganda") @db.VarChar(100)
  postalCode         String? @db.VarChar(20)

  occupation        String? @db.VarChar(100)
  companyName       String? @db.VarChar(200)
  designation       String? @db.VarChar(100)
  yearsOfExperience Int?

  maritalStatus MaritalStatus?
  spouseName    String?        @db.VarChar(100)
  religion      String?        @db.VarChar(50)
  language      String[]       @default(["en", "sw"])

  profilePictureUrl String? @db.VarChar(500)
  signatureUrl      String? @db.VarChar(500)

  preferredLanguage       String @default("en") @db.VarChar(10)
  timezone                String @default("Africa/Kampala") @db.VarChar(50)
  currency                String @default("UGX") @db.VarChar(10)
  notificationPreferences Json?

  verificationLevel String    @default("BASIC") @db.VarChar(20)
  verifiedByAdminId String?
  verificationDate  DateTime?

  personalQRCode String?   @unique @db.VarChar(100)
  qrCodeExpiry   DateTime?

  bankName          String? @db.VarChar(100)
  bankAccountNumber String? @db.VarChar(50)
  bankAccountName   String? @db.VarChar(150)

  metadata          Json?
  version           Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastProfileUpdate DateTime?

  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy Admin? @relation("ProfileVerifier", fields: [verifiedByAdminId], references: [id])

  @@index([verificationLevel])
  @@map("user_profiles")
}

/**
 * ************
 * AUTHENTICATION & SECURITY
 * ************
 */
model VerificationToken {
  id        String                @id @default(uuid())
  token     String                @unique @db.VarChar(255)
  tokenType VerificationTokenType
  userId    String?
  email     String?               @db.VarChar(255)
  phone     String?               @db.VarChar(20)

  maxAttempts Int     @default(3)
  attempts    Int     @default(0)
  isUsed      Boolean @default(false)

  expiresAt DateTime
  usedAt    DateTime?

  ipAddress String? @db.VarChar(45)
  userAgent String? @db.VarChar(500)
  location  Json?

  purposeData Json?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("verification_tokens")
}

model UserSession {
  id           String  @id @default(uuid())
  userId       String
  sessionToken String  @unique @db.VarChar(255)
  refreshToken String? @unique @db.VarChar(255)

  deviceId   String? @db.VarChar(100)
  deviceName String? @db.VarChar(100)
  deviceType String? @db.VarChar(50)
  os         String? @db.VarChar(50)
  browser    String? @db.VarChar(100)

  ipAddress   String? @db.VarChar(45)
  city        String? @db.VarChar(100)
  country     String? @db.VarChar(100)
  coordinates Json?

  mfaVerified  Boolean  @default(false)
  lastActivity DateTime @default(now())
  expiresAt    DateTime

  isActive     Boolean @default(true)
  logoutReason String? @db.VarChar(100)

  createdAt   DateTime  @default(now())
  loggedOutAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
  @@index([refreshToken])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Geolocation {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(200)
  code        String   @unique @db.VarChar(20)
  country     String   @default("Uganda") @db.VarChar(100)
  countryCode String   @default("UG") @db.VarChar(10)
  timezone    String   @default("Africa/Kampala") @db.VarChar(50)
  currency    String   @default("UGX") @db.VarChar(10)
  language    String   @default("en") @db.VarChar(10)
  regionType  String   @default("REGION") @db.VarChar(50)
  population  Int?
  areaSqKm    Float?
  coordinates Json?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  districts District[]

  @@index([code])
  @@map("geolocations")
}

model District {
  id            String   @id @default(uuid())
  geolocationId String   @default("")
  name          String   @db.VarChar(200)
  code          String   @unique @db.VarChar(20)
  districtType  String?  @db.VarChar(50)
  population    Int?
  areaSqKm      Float?
  headquarters  String?  @db.VarChar(200)
  coordinates   Json?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  geolocation    Geolocation     @relation(fields: [geolocationId], references: [id])
  cities         City[]
  districtAdmins DistrictAdmin[]

  invitations Invitation[] @relation("DistrictInvitations")

  @@index([geolocationId])
  @@map("districts")
}

model City {
  id          String   @id @default(uuid())
  districtId  String
  name        String   @db.VarChar(200)
  code        String   @unique @db.VarChar(20)
  cityType    String?  @db.VarChar(50)
  population  Int?
  areaSqKm    Float?
  mayor       String?  @db.VarChar(150)
  coordinates Json?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  district   District    @relation(fields: [districtId], references: [id])
  markets    Market[]
  cityAdmins CityAdmin[]

  invitations Invitation[] @relation("CityInvitations")

  @@index([districtId])
  @@map("cities")
}

model Market {
  id          String  @id @default(uuid())
  cityId      String
  name        String  @db.VarChar(200)
  uniqueCode  String  @unique @db.VarChar(50)
  displayName String? @db.VarChar(200)
  description String? @db.Text
  address     String  @db.VarChar(500)

  marketType MarketType @default(PERMANENT)
  categories String[]

  totalLevels    Int  @default(1)
  totalSections  Int  @default(0)
  totalShops     Int  @default(0)
  totalStalls    Int  @default(0)
  occupiedShops  Int  @default(0)
  occupiedStalls Int  @default(0)
  maxCapacity    Int?

  openingTime     String   @default("06:00") @db.VarChar(10)
  closingTime     String   @default("20:00") @db.VarChar(10)
  operatingDays   String[] @default(["MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY", "SATURDAY"])
  is24Hours       Boolean  @default(false)
  holidaySchedule Json?

  contactPhone String? @db.VarChar(20)
  contactEmail String? @db.VarChar(255)
  website      String? @db.VarChar(200)
  managerName  String? @db.VarChar(150)

  averageRent           Decimal? @db.Decimal(12, 2)
  securityDeposit       Decimal? @db.Decimal(12, 2)
  monthlyMaintenanceFee Decimal? @db.Decimal(10, 2)

  status            String    @default("ACTIVE") @db.VarChar(50)
  establishmentDate DateTime?
  lastRenovation    DateTime?
  notes             String?   @db.Text

  createdByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  city      City   @relation(fields: [cityId], references: [id])
  createdBy Admin? @relation("MarketCreator", fields: [createdByAdminId], references: [id])

  levels   MarketLevel[]
  sections MarketSection[]
  shops    Shop[]
  stalls   Stall[]         @relation("MarketStalls")
  gates    MarketGate[]

  marketMasters MarketMaster[]
  pseudoAdmins  PseudoMarketAdmin[]
  vendors       Vendor[]            @relation("PrimaryMarketVendors")

  dailyCollections     DailyCollection[]
  taxes                MarketTax[]
  marketTokens         MarketToken[]         @relation("MarketTokens")
  rentInvoices         RentInvoice[]
  paymentClaims        PaymentClaim[]
  invoicePayments      InvoicePayment[]
  paymentAttempts      PaymentAttempt[]
  paymentWebhookEvents PaymentWebhookEvent[]
  vendorCredits        VendorCredit[]
  refundRecords        RefundRecord[]

  tokenGenerationConfigs TokenGenerationConfig[]

  gateEntries       GateEntry[]        @relation("MarketGateEntries")
  stockMovements    StockMovement[]    @relation("MarketStockMovements")
  taxPayments       TaxPayment[]       @relation("MarketTaxPayments")
  healthInspections HealthInspection[] @relation("MarketHealthInspections")

  scannerDevices ScannerDevice[] @relation("MarketScannerDevices")

  invitations Invitation[] @relation("MarketInvitations")

  @@unique([cityId, name])
  @@index([cityId])
  @@map("markets")
}

model MarketLevel {
  id          String  @id @default(uuid())
  marketId    String
  levelNumber Int
  uniqueCode  String  @unique @db.VarChar(50)
  name        String  @db.VarChar(100)
  description String? @db.Text

  accessType   String? @db.VarChar(50)
  hasElevator  Boolean @default(false)
  hasEscalator Boolean @default(false)
  hasRestrooms Boolean @default(true)
  hasParking   Boolean @default(false)

  totalSections Int @default(0)
  totalShops    Int @default(0)
  totalStalls   Int @default(0)

  wheelchairAccess Boolean @default(false)
  emergencyExits   Int     @default(2)

  status         String    @default("ACTIVE") @db.VarChar(50)
  isOperational  Boolean   @default(true)
  lastInspection DateTime?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  market    Market @relation(fields: [marketId], references: [id], onDelete: Cascade)
  createdBy User   @relation("LevelCreatedBy", fields: [createdById], references: [id])

  sections MarketSection[]
  shops    Shop[]          @relation("LevelShops")
  stalls   Stall[]         @relation("LevelStalls")

  @@unique([marketId, levelNumber])
  @@index([marketId])
  @@map("market_levels")
}

model MarketSection {
  id          String  @id @default(uuid())
  marketId    String
  levelId     String?
  uniqueCode  String  @unique @db.VarChar(50)
  name        String  @db.VarChar(100)
  displayName String? @db.VarChar(150)
  description String? @db.Text

  sectionType  String   @db.VarChar(100)
  subType      String?  @db.VarChar(100)
  categoryTags String[]

  locationCode String? @db.VarChar(10)
  entranceGate String? @db.VarChar(50)

  totalShops     Int  @default(0)
  totalStalls    Int  @default(0)
  occupiedShops  Int  @default(0)
  occupiedStalls Int  @default(0)
  maxCapacity    Int?

  hasAirConditioning Boolean @default(false)
  hasCommonLighting  Boolean @default(true)
  hasWaterSupply     Boolean @default(true)
  hasSecurityCamera  Boolean @default(false)

  supervisorId String?
  assistantIds String[]

  status      String  @default("ACTIVE") @db.VarChar(50)
  openingTime String? @db.VarChar(10)
  closingTime String? @db.VarChar(10)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  market     Market             @relation(fields: [marketId], references: [id], onDelete: Cascade)
  level      MarketLevel?       @relation(fields: [levelId], references: [id])
  supervisor PseudoMarketAdmin? @relation("SectionSupervisor", fields: [supervisorId], references: [id])
  createdBy  User               @relation("SectionCreatedBy", fields: [createdById], references: [id])

  shops  Shop[]        @relation("SectionShops")
  stalls Stall[]       @relation("SectionStalls")
  aisles MarketAisle[]

  sectionRules        Json?
  specialRequirements String? @db.VarChar(500)

  @@unique([marketId, levelId, name])
  @@index([marketId])
  @@map("market_sections")
}

model MarketAisle {
  id          String  @id @default(uuid())
  sectionId   String
  uniqueCode  String  @unique @db.VarChar(50)
  aisleNumber String  @db.VarChar(20)
  name        String? @db.VarChar(100)

  aisleType String  @default("MAIN") @db.VarChar(20)
  isCovered Boolean @default(true)

  maxStallsPerSide Int?

  fireExitAccess    Boolean @default(true)
  emergencyLighting Boolean @default(true)

  status          String    @default("ACTIVE") @db.VarChar(50)
  lastCleaning    DateTime?
  lastMaintenance DateTime?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  section   MarketSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  createdBy User          @relation("AisleCreatedBy", fields: [createdById], references: [id])

  stalls Stall[] @relation("AisleStalls")

  @@unique([sectionId, aisleNumber])
  @@index([sectionId])
  @@map("market_aisles")
}

/**
 * ************
 * STAKEHOLDERS
 * ************
 */
model Stakeholder {
  id                   String          @id @default(uuid())
  userId               String          @unique
  stakeholderType      StakeholderType
  kycStatus            KycStatus       @default(NOT_SUBMITTED)
  kycSubmittedAt       DateTime?
  kycVerifiedAt        DateTime?
  kycVerifiedByAdminId String?
  kycDocuments         Json?
  bankAccountDetails   Json?
  taxComplianceStatus  String?         @default("COMPLIANT") @db.VarChar(50)
  businessRating       Float?          @default(5.0)
  notes                String?         @db.Text
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  kycVerifiedBy Admin? @relation("KycVerifier", fields: [kycVerifiedByAdminId], references: [id])

  marketAuthority MarketAuthority?
  member          Member?
  vendor          Vendor?
  supplier        Supplier?
  customer        Customer?
  guest           Guest?

  transactions   Transaction[]
  documents      Document[]
  assets         DigitalAsset[]  @relation("StakeholderAssets")
  kycSubmissions KycSubmission[]

  auditLogs AuditLog[] @relation("StakeholderAuditLogs")

  @@map("stakeholders")
}

model MarketAuthority {
  id                 String   @id @default(uuid())
  stakeholderId      String   @unique
  authorityName      String   @db.VarChar(200)
  registrationNumber String   @unique @db.VarChar(100)
  jurisdiction       String[]
  contactPerson      String?  @db.VarChar(150)
  officeAddress      String?  @db.VarChar(500)
  website            String?  @db.VarChar(200)

  stakeholder Stakeholder @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)

  marketRegulations MarketRegulation[]
  issuedLicenses    BusinessLicense[]

  @@map("market_authorities")
}

model Member {
  id                 String    @id @default(uuid())
  stakeholderId      String    @unique
  membershipNumber   String    @unique @db.VarChar(50)
  membershipType     String    @default("REGULAR") @db.VarChar(50)
  membershipSince    DateTime  @default(now())
  membershipExpiry   DateTime?
  businessName       String    @db.VarChar(200)
  businessType       String?   @db.VarChar(100)
  registrationNumber String    @unique @db.VarChar(100)
  taxIdNumber        String?   @unique @db.VarChar(50)
  tradeLicenseNumber String?   @unique @db.VarChar(100)
  yearsInBusiness    Int?

  stakeholder Stakeholder @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)

  shops         Shop[]
  rentContracts RentContract[] @relation("MemberAsLandlord")

  @@index([businessName])
  @@map("members")
}

model Vendor {
  id                    String   @id @default(uuid())
  stakeholderId         String   @unique
  vendorCode            String   @unique @db.VarChar(50)
  businessName          String   @db.VarChar(200)
  businessType          String?  @db.VarChar(100)
  businessLicenseNumber String?  @unique @db.VarChar(100)
  taxIdNumber           String?  @unique @db.VarChar(50)
