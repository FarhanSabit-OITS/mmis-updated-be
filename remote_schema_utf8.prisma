  managedStalls   Stall[]       @relation("StallManager")
  rentCollections RentPayment[]
  vendorApprovals Vendor[]      @relation("VendorApprover")

  @@index([marketId])
  @@map("market_masters")
}

model PseudoMarketAdmin {
