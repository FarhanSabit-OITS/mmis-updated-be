model Shop {
  id        String  @id @default(uuid())
  marketId  String
  levelId   String?
  sectionId String?
  memberId  String

  uniqueCode  String  @unique @db.VarChar(50)
  shopNumber  String  @db.VarChar(20)
  displayName String? @db.VarChar(150)
  shopName    String  @db.VarChar(200)

  shopType     ShopType @default(RETAIL)
  subType      String?  @db.VarChar(100)
  categoryTags String[]

  locationDescription String?  @db.VarChar(500)
  accessPoints        String[]

  hasElectricity     Boolean @default(true)
  hasWaterSupply     Boolean @default(true)
  hasStorage         Boolean @default(false)
  hasAirConditioning Boolean @default(false)
  hasDisplayWindow   Boolean @default(true)
  hasSecurityShutter Boolean @default(true)

  electricityMeterNumber String? @db.VarChar(50)
  waterMeterNumber       String? @db.VarChar(50)
  internetConnection     Boolean @default(false)

  monthlyRent     Decimal  @db.Decimal(12, 2)
  securityDeposit Decimal? @db.Decimal(12, 2)
  maintenanceFee  Decimal? @db.Decimal(10, 2)
  electricityRate Decimal? @db.Decimal(8, 2)
  waterRate       Decimal? @db.Decimal(8, 2)

  contractStartDate DateTime
  contractEndDate   DateTime
  paymentDay        Int      @default(1)
  gracePeriodDays   Int      @default(5)

  status            String    @default("ACTIVE") @db.VarChar(50)
  occupationStatus  String    @default("OCCUPIED") @db.VarChar(50)
  lastRenovation    DateTime?
  inspectionDueDate DateTime?

  inventoryValue Decimal? @db.Decimal(15, 2)

  createdById    String
  marketMasterId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  market       Market         @relation(fields: [marketId], references: [id], onDelete: Cascade)
  level        MarketLevel?   @relation("LevelShops", fields: [levelId], references: [id])
  section      MarketSection? @relation("SectionShops", fields: [sectionId], references: [id])
  member       Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  marketMaster MarketMaster?  @relation("ShopManager", fields: [marketMasterId], references: [id])
  createdBy    User           @relation("ShopCreatedBy", fields: [createdById], references: [id])

  stalls        Stall[]
  rentContracts RentContract[]
  rentInvoices  RentInvoice[]
  shopAssets    ShopAsset[]

  @@unique([marketId, shopNumber])
  @@index([marketId])
  @@index([memberId])
  @@map("shops")
}

model Stall {
  id        String  @id @default(uuid())
  shopId    String
  vendorId  String
  sectionId String?
  aisleId   String?
  levelId   String?

  uniqueCode  String  @unique @db.VarChar(50)
  stallNumber String  @db.VarChar(20)
  displayName String? @db.VarChar(150)

  stallType      StallType @default(PERMANENT)
  category       String    @db.VarChar(100)
  subCategories  String[]
  specialization String?   @db.VarChar(100)

  hasDisplayCounter Boolean @default(true)
  hasStorage        Boolean @default(false)
  hasLighting       Boolean @default(true)
  hasPowerOutlet    Boolean @default(true)
  hasCashRegister   Boolean @default(false)

  dailyRate       Decimal  @db.Decimal(10, 2)
  monthlyRate     Decimal? @db.Decimal(12, 2)
  securityDeposit Decimal? @db.Decimal(12, 2)
  billingCycle    String   @default("DAILY") @db.VarChar(20)

  contractStartDate DateTime
  contractEndDate   DateTime?
  agreementTerms    Json?

  openingTime   String?  @db.VarChar(10)
  closingTime   String?  @db.VarChar(10)
  operatingDays String[] @default(["MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY", "SATURDAY"])

  status            String    @default("ACTIVE") @db.VarChar(50)
  operationalStatus String    @default("OPERATIONAL") @db.VarChar(50)
  lastStockCheck    DateTime?
  lastCleaning      DateTime?

  visitCount Int @default(0)

  qrCode String? @unique @db.VarChar(100)

  createdById    String
  marketMasterId String?
  marketId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shop         Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  vendor       Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  section      MarketSection? @relation("SectionStalls", fields: [sectionId], references: [id])
  aisle        MarketAisle?   @relation("AisleStalls", fields: [aisleId], references: [id])
  marketMaster MarketMaster?  @relation("StallManager", fields: [marketMasterId], references: [id])
  market       Market         @relation("MarketStalls", fields: [marketId], references: [id])
  level        MarketLevel?   @relation("LevelStalls", fields: [levelId], references: [id])
  createdBy    User           @relation("StallCreatedBy", fields: [createdById], references: [id])

  products     Product[]
  sales        Sale[]
  stallAssets  StallAsset[]
  gateEntries  GateEntry[]
  marketTokens MarketToken[]

  healthInspections HealthInspection[]

  @@unique([shopId, stallNumber])
  @@index([shopId])
  @@index([vendorId])
  @@map("stalls")
}

model Admin {
  id                String     @id @default(uuid())
