model MarketGate {
  id         String  @id @default(uuid())
  marketId   String
  uniqueCode String  @unique @db.VarChar(50)
  gateNumber String  @db.VarChar(20)
  gateName   String? @db.VarChar(100)
  gateType   String  @default("ENTRY") @db.VarChar(20)
  location   String? @db.VarChar(200)

  accessType          String @default("ALL") @db.VarChar(20)
  allowedVehicleTypes Json

  hasScanner       Boolean @default(false)
  hasCamera        Boolean @default(false)
  hasSecurityCheck Boolean @default(false)

  isOperational     Boolean @default(true)
  operatingHours    Json?
  assignedStaffId   String?
  assignedCounterId String?

  status          String    @default("ACTIVE") @db.VarChar(50)
  lastMaintenance DateTime?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  market          Market             @relation(fields: [marketId], references: [id], onDelete: Cascade)
  assignedStaff   PseudoMarketAdmin? @relation("GateStaffAssignment", fields: [assignedStaffId], references: [id])
  assignedCounter PseudoMarketAdmin? @relation("GateCounterAssignment", fields: [assignedCounterId], references: [id])
  createdBy       User               @relation("GateCreatedBy", fields: [createdById], references: [id])

  gateEntries    GateEntry[]
  gateOperations GateOperation[]
  scannerDevices ScannerDevice[]

  marketTokens   MarketToken[]   @relation("GateTokens")
  tokenUsageLogs TokenUsageLog[] @relation("GateTokenUsageLogs")
  qrScanLogs     QrScanLog[]     @relation("GateQrScanLogs")

  @@unique([marketId, gateNumber])
  @@index([uniqueCode])
  @@index([marketId])
  @@index([gateType])
  @@map("market_gates")
}

model MarketToken {
  id String @id @default(uuid())

  tokenCode String          @unique @db.VarChar(100)
  tokenType MarketTokenType
  shortCode String?         @unique @db.VarChar(50)

  tokenValue   String? @unique @db.VarChar(255)
  displayValue String? @db.VarChar(100)

  marketId   String
  gateId     String?
  stallId    String?
  vendorId   String?
  customerId String?
  adminId    String?
  userId     String?
  guestId    String?

  vehicleNumber String? @db.VarChar(50)
  vehicleType   String? @db.VarChar(50)
  driverName    String? @db.VarChar(100)
  visitorName   String? @db.VarChar(100)
  visitorType   String? @db.VarChar(50)

  transactionId String?
  amount        Decimal? @db.Decimal(12, 2)
  currency      String   @default("UGX") @db.VarChar(10)

  purpose     String? @db.VarChar(200)
  description String? @db.VarChar(500)
  metadata    Json?

  issuedAt    DateTime @default(now())
  validFrom   DateTime @default(now())
  expiresAt   DateTime
  isSingleUse Boolean  @default(true)
  maxUses     Int      @default(1)
  currentUses Int      @default(0)

  status             TokenStatus @default(PENDING)
  usedAt             DateTime?
  invalidatedAt      DateTime?
  invalidationReason String?     @db.VarChar(500)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  market    Market      @relation("MarketTokens", fields: [marketId], references: [id])
  gate      MarketGate? @relation("GateTokens", fields: [gateId], references: [id])
  stall     Stall?      @relation(fields: [stallId], references: [id])
  vendor    Vendor?     @relation(fields: [vendorId], references: [id])
  customer  Customer?   @relation(fields: [customerId], references: [id])
  admin     Admin?      @relation("AdminIssuedTokens", fields: [adminId], references: [id])
  user      User?       @relation(fields: [userId], references: [id])
  guest     Guest?      @relation("GuestMarketTokens", fields: [guestId], references: [id])
  createdBy User        @relation("TokenCreatedBy", fields: [createdById], references: [id])

  tokenLogs      TokenUsageLog[]
  gateOperations GateOperation[]

  @@index([tokenCode])
  @@index([shortCode])
  @@index([tokenType])
  @@index([marketId])
  @@index([gateId])
  @@index([vendorId])
  @@index([status])
  @@index([expiresAt])
  @@index([issuedAt])
  @@map("market_tokens")
}

model TokenUsageLog {
  id      String @id @default(uuid())
  tokenId String
  action  String @db.VarChar(50)

  usedByUserId    String?
  usedByAdminId   String?
  usedAtGateId    String?
  usedAtCounterId String? @db.VarChar(100)

  deviceId   String? @db.VarChar(100)
  deviceType String? @db.VarChar(50)
  scannerId  String? @db.VarChar(100)

  ipAddress      String? @db.VarChar(45)
  gpsCoordinates Json?

  isValid           Boolean
  validationMessage String? @db.VarChar(500)

  metadata Json?

  createdAt DateTime @default(now())

  token         MarketToken    @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  usedByUser    User?          @relation("UserTokenUsageLogs", fields: [usedByUserId], references: [id])
  usedByAdmin   Admin?         @relation("AdminTokenUsageLogs", fields: [usedByAdminId], references: [id])
  usedAtGate    MarketGate?    @relation("GateTokenUsageLogs", fields: [usedAtGateId], references: [id])
  scannerDevice ScannerDevice? @relation(fields: [scannerId], references: [deviceId])

  @@index([tokenId])
  @@index([action])
  @@index([usedByUserId])
  @@index([usedAtGateId])
  @@index([createdAt])
  @@map("token_usage_logs")
}

model QrCode {
  id String @id @default(uuid())

  qrCode    String     @unique @db.VarChar(255)
  qrType    QrCodeType
  shortCode String?    @unique @db.VarChar(50)

  entityType String @db.VarChar(50)
  entityId   String

  encodedData   Json
  publicData    Json?
  encryptionKey String? @db.VarChar(255)

  size            Int     @default(256)
  errorCorrection String  @default("M") @db.VarChar(5)
  foregroundColor String  @default("#000000") @db.VarChar(10)
  backgroundColor String  @default("#FFFFFF") @db.VarChar(10)
  logoUrl         String? @db.VarChar(500)

  scanCount    Int       @default(0)
  lastScanned  DateTime?
  firstScanned DateTime?

  validFrom DateTime  @default(now())
  expiresAt DateTime?
  isActive  Boolean   @default(true)

  maxScans        Int?
  requireAuth     Boolean  @default(false)
  allowedScanners String[]

  createdById String
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User  @relation("QrCodeCreatedBy", fields: [createdById], references: [id])
  user      User? @relation("UserQrCodes", fields: [userId], references: [id])

  scanLogs       QrScanLog[]
  gateOperations GateOperation[]

  @@index([qrCode])
  @@index([shortCode])
  @@index([qrType])
  @@index([entityType, entityId])
  @@index([isActive])
  @@index([expiresAt])
  @@map("qr_codes")
}

model QrScanLog {
  id        String  @id @default(uuid())
  qrCodeId  String
  scannerId String? @db.VarChar(100)

  scannedByUserId    String?
  scannedByAdminId   String?
  scannedAtGateId    String?
  scannedAtCounterId String? @db.VarChar(100)

  deviceId   String? @db.VarChar(100)
  deviceType String? @db.VarChar(50)
  os         String? @db.VarChar(50)
  browser    String? @db.VarChar(100)

  ipAddress      String? @db.VarChar(45)
  gpsCoordinates Json?

  isValid          Boolean
  validationResult Json?
  errorMessage     String? @db.VarChar(500)

  responseData Json?

  scannedAt DateTime @default(now())

  qrCode         QrCode         @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  scannedByUser  User?          @relation("UserQrScanLogs", fields: [scannedByUserId], references: [id])
  scannedByAdmin Admin?         @relation("AdminQrScanLogs", fields: [scannedByAdminId], references: [id])
  scannedAtGate  MarketGate?    @relation("GateQrScanLogs", fields: [scannedAtGateId], references: [id])
  scannerDevice  ScannerDevice? @relation(fields: [scannerId], references: [deviceId])

  @@index([qrCodeId])
  @@index([scannedByUserId])
  @@index([scannedAtGateId])
  @@index([scannedAt])
  @@index([isValid])
  @@map("qr_scan_logs")
}

model GateOperation {
  id String @id @default(uuid())

  gateId        String
  operationType String @db.VarChar(50)

  tokenId  String?
  qrCodeId String?

  entityType String? @db.VarChar(50)
  entityId   String?
  entityName String? @db.VarChar(150)

  vehicleNumber String? @db.VarChar(50)
  vehicleType   String? @db.VarChar(50)
  driverName    String? @db.VarChar(100)

  goodsDescription String?  @db.VarChar(500)
  quantity         Decimal? @db.Decimal(12, 2)
  weight           Decimal? @db.Decimal(10, 2)

  inspectionNotes  String? @db.Text
  inspectionResult String? @db.VarChar(50)
  inspectorId      String?

  entryTime       DateTime?
  exitTime        DateTime?
  durationMinutes Int?

  status        String  @default("COMPLETED") @db.VarChar(50)
  isApproved    Boolean @default(true)
  approvalNotes String? @db.VarChar(500)

  recordedById  String?
  validatedById String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations - FIXED
  gate        MarketGate         @relation(fields: [gateId], references: [id], onDelete: Cascade)
  token       MarketToken?       @relation(fields: [tokenId], references: [id])
  qrCode      QrCode?            @relation(fields: [qrCodeId], references: [id])
  inspector   PseudoMarketAdmin? @relation("GateOperationInspector", fields: [inspectorId], references: [id])
