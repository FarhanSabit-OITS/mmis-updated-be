{{!-- src/templates/email_template.hbs --}}
<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="x-apple-disable-message-reformatting">
    <title>MMIS</title>
    <style>
        body, table, td, p, a {
            margin: 0;
            padding: 0;
        }
        body {
            width: 100% !important;
            min-width: 100%;
            background-color: #efece6;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }
        table {
            border-collapse: collapse;
            border-spacing: 0;
        }
        img {
            border: 0;
            outline: none;
            text-decoration: none;
            display: block;
        }
        a {
            text-decoration: none;
        }
        .wrapper-bg {
            background-color: #efece6;
            background-image: radial-gradient(#d1ccc0 1.5px, transparent 1.5px);
            background-size: 24px 24px;
        }
        .email-card {
            width: 680px;
            max-width: 680px;
            background-color: #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.6);
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 24px 48px -12px rgba(45, 49, 66, 0.15);
        }
        .header-cell {
            padding: 34px 46px;
            background-color: #ffffff;
        }
        .brand-name {
            font-size: 18px;
            font-weight: 800;
            letter-spacing: 2px;
            line-height: 1;
            color: #1a1e29;
            text-transform: uppercase;
        }
        .brand-subtitle {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 3px;
            line-height: 1.4;
            color: #9095a9;
            text-transform: uppercase;
            text-align: right;
        }
        .hero-cell {
            padding: 56px 46px 34px 46px;
            background-color: #1a1e29;
            background-image:
                radial-gradient(circle at 100% 0%, rgba(255,123,84,0.8) 0, rgba(255,123,84,0.5) 16%, rgba(255,123,84,0) 40%),
                radial-gradient(circle at 0% 100%, rgba(5,150,105,0.58) 0, rgba(5,150,105,0.36) 14%, rgba(5,150,105,0) 34%),
                radial-gradient(#3d382f 1.5px, transparent 1.5px);
            background-size: auto, auto, 27px 27px;
            background-position: center center, center center, top left;
            background-repeat: no-repeat, no-repeat, repeat;
        }
        .accent-tag {
            display: inline-block;
            padding: 7px 15px;
            font-size: 11px;
            font-weight: 700;
            line-height: 1;
            letter-spacing: 1.8px;
            text-transform: uppercase;
            color: #ffb26b;
            border: 1px solid rgba(255, 178, 107, 0.24);
            border-radius: 999px;
            background-color: rgba(255, 255, 255, 0.08);
        }
        .hero-title {
            padding-top: 22px;
            font-family: Georgia, "Times New Roman", serif;
            font-size: 46px;
            line-height: 1.14;
            font-weight: 400;
            letter-spacing: -0.6px;
            color: #ffffff;
        }
        .body-cell {
            padding: 54px 46px 42px 46px;
            background-color: #ffffff;
        }
        .body-copy {
            font-size: 16px;
            line-height: 1.8;
            color: #4a4d5e;
        }
        .body-copy strong {
            color: #111827;
            font-weight: 600;
        }
        .spacer-24 {
            line-height: 24px;
            font-size: 24px;
        }
        .spacer-40 {
            line-height: 40px;
            font-size: 40px;
        }
        .button-wrap {
            padding-top: 6px;
            text-align: center;
        }
        .cta-button {
            display: inline-block;
            padding: 17px 44px;
            font-size: 16px;
            line-height: 1.2;
            font-weight: 600;
            color: #ffffff !important;
            background-color: #ff7b54;
            border-radius: 999px;
            box-shadow: 0 10px 20px -5px rgba(255, 123, 84, 0.3);
        }
        .footer-cell {
            padding: 24px 46px 26px 46px;
            text-align: center;
            background-color: #fafafa;
            border-top: 1px solid #f0f0f0;
        }
        .social-link {
            display: inline-block;
            margin: 0 10px;
            font-size: 11px;
            line-height: 1.4;
            font-weight: 600;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            color: #9095a9 !important;
        }
        .footer-text {
            padding-top: 16px;
            font-size: 11px;
            line-height: 1.6;
            color: #a0a4b8;
        }
        @media only screen and (max-width: 720px) {
            .email-card {
                width: 100% !important;
                max-width: 100% !important;
            }
            .header-cell,
            .hero-cell,
            .body-cell,
            .footer-cell {
                padding-left: 24px !important;
                padding-right: 24px !important;
            }
            .hero-cell {
                padding-top: 44px !important;
                padding-bottom: 28px !important;
                background-image:
                    radial-gradient(circle at 100% 0%, rgba(255,123,84,0.78) 0, rgba(255,123,84,0.46) 14%, rgba(255,123,84,0) 34%),
                    radial-gradient(circle at 0% 100%, rgba(5,150,105,0.54) 0, rgba(5,150,105,0.34) 12%, rgba(5,150,105,0) 28%),
                    radial-gradient(#3d382f 1.4px, transparent 1.4px) !important;
                background-size: auto, auto, 24px 24px !important;
            }
            .hero-title {
                font-size: 34px !important;
            }
            .brand-subtitle {
                font-size: 9px !important;
                letter-spacing: 1.6px !important;
            }
            .cta-button {
                display: block !important;
                width: 100% !important;
                box-sizing: border-box !important;
            }
        }
    </style>
</head>
<body style="margin:0; padding:0; background-color:#efece6;">
    <center role="article" aria-roledescription="email" lang="en" style="width:100%; background-color:#efece6;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="wrapper-bg" style="width:100%; background-color:#efece6; background-image:radial-gradient(#d1ccc0 1.5px, transparent 1.5px); background-size:24px 24px;">
            <tr>
                <td align="center" style="padding:48px 16px;">
                    <table role="presentation" width="680" cellpadding="0" cellspacing="0" border="0" class="email-card" style="width:680px; max-width:680px; background-color:#ffffff; border:1px solid rgba(255,255,255,0.6); border-radius:24px; overflow:hidden; box-shadow:0 24px 48px -12px rgba(45,49,66,0.15);">
                        <tr>
                            <td class="header-cell" style="padding:34px 46px; background-color:#ffffff;">
                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                    <tr>
                                        <td valign="middle" style="width:32%;">
                                            <div class="brand-name" style="font-size:18px; font-weight:800; letter-spacing:2px; line-height:1; color:#1a1e29; text-transform:uppercase;">MMIS</div>
                                        </td>
                                        <td valign="middle" style="width:68%;">
                                            <div class="brand-subtitle" style="font-size:11px; font-weight:600; letter-spacing:3px; line-height:1.4; color:#9095a9; text-transform:uppercase; text-align:right;">Empowering African Markets with Technology</div>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td class="hero-cell" style="padding:84px 46px 70px 46px; background-color:#1a1e29; background-image:radial-gradient(circle at 82% 34%, rgba(255,123,84,0.78) 0, rgba(255,123,84,0.48) 12%, rgba(255,123,84,0) 30%), radial-gradient(circle at 10% 78%, rgba(5,150,105,0.52) 0, rgba(5,150,105,0.34) 10%, rgba(5,150,105,0) 24%), radial-gradient(#3d382f 1.5px, transparent 1.5px); background-size:auto, auto, 27px 27px; background-position:center center, center center, top left; background-repeat:no-repeat, no-repeat, repeat;">
                                <div class="accent-tag" style="display:inline-block; padding:7px 15px; font-size:11px; font-weight:700; line-height:1; letter-spacing:1.8px; text-transform:uppercase; color:#ffb26b; border:1px solid rgba(255,178,107,0.24); border-radius:999px; background-color:rgba(255,255,255,0.08);">{{ctaTag}}</div>
                                <div class="hero-title" style="padding-top:28px; font-family:Georgia, 'Times New Roman', serif; font-size:46px; line-height:1.14; font-weight:400; letter-spacing:-0.6px; color:#ffffff;">{{heroTitle}}</div>
                            </td>
                        </tr>
                        <tr>
                            <td class="body-cell" style="padding:54px 46px 42px 46px; background-color:#ffffff;">
                                <p class="body-copy" style="margin:0; font-size:16px; line-height:1.8; color:#4a4d5e;"><strong style="color:#111827; font-weight:600;">Hello {{name}},</strong></p>
                                <div class="spacer-24" style="line-height:24px; font-size:24px;">&nbsp;</div>
                                <p class="body-copy" style="margin:0; font-size:16px; line-height:1.8; color:#4a4d5e;">{{intro}}</p>
                                <div class="spacer-24" style="line-height:24px; font-size:24px;">&nbsp;</div>
                                <p class="body-copy" style="margin:0; font-size:16px; line-height:1.8; color:#4a4d5e;">{{outro}}</p>
                                <div class="spacer-40" style="line-height:40px; font-size:40px;">&nbsp;</div>
                                <div class="button-wrap" style="padding-top:6px; text-align:center;">
                                    <a href="{{actionUrl}}" class="cta-button" style="display:inline-block; padding:17px 44px; font-size:16px; line-height:1.2; font-weight:600; color:#ffffff; background-color:#ff7b54; border-radius:999px; box-shadow:0 10px 20px -5px rgba(255,123,84,0.3);">{{actionText}}</a>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td class="footer-cell" style="padding:24px 46px 26px 46px; text-align:center; background-color:#fafafa; border-top:1px solid #f0f0f0;">
                                <a href="#" class="social-link" style="display:inline-block; margin:0 10px; font-size:11px; line-height:1.4; font-weight:600; letter-spacing:1.2px; text-transform:uppercase; color:#9095a9;">Twitter</a>
                                <a href="#" class="social-link" style="display:inline-block; margin:0 10px; font-size:11px; line-height:1.4; font-weight:600; letter-spacing:1.2px; text-transform:uppercase; color:#9095a9;">LinkedIn</a>
                                <a href="#" class="social-link" style="display:inline-block; margin:0 10px; font-size:11px; line-height:1.4; font-weight:600; letter-spacing:1.2px; text-transform:uppercase; color:#9095a9;">Instagram</a>
                                <div class="footer-text" style="padding-top:16px; font-size:11px; line-height:1.6; color:#a0a4b8;">&copy; 2026 MMIS. All rights reserved.</div>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </center>
</body>
</html>
