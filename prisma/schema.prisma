  @@index([status])
  @@map("product_reviews")
}

model Complaint {
  id                   String    @id @default(uuid())
  customerId           String
  stallId              String?
  title                String    @db.VarChar(200)
  description          String
  category             String?   @db.VarChar(100)
  status               String    @default("PENDING") @db.VarChar(50)
  priority             String    @default("MEDIUM") @db.VarChar(20)
  assignedToId         String?
  resolution           String?
  resolvedAt           DateTime?
  resolutionNotes      String?
  customerSatisfaction Int?
  feedback             String?
  metadata             Json?
  createdById          String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  customer             Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([stallId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@map("complaints")
}

model LoyaltyTransaction {
  id            String    @id @default(uuid())
  customerId    String
  points        Int
  type          String    @db.VarChar(50)
  referenceId   String?   @db.VarChar(100)
  referenceType String?   @db.VarChar(50)
  expiresAt     DateTime?
  status        String    @default("COMPLETED") @db.VarChar(50)
  description   String?   @db.VarChar(500)
  metadata      Json?
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     User      @relation(fields: [createdById], references: [id])
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([type])
  @@index([referenceId])
  @@index([createdAt])
  @@map("loyalty_transactions")
}

model GuestEntry {
  id                String    @id @default(uuid())
  guestId           String
  marketId          String
  entryTime         DateTime
  exitTime          DateTime?
  purpose           String?   @db.VarChar(100)
  visitedStalls     String[]
  verifiedById      String?
  verificationNotes String?
  metadata          Json?
  createdById       String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdBy         User      @relation("GuestCreator", fields: [createdById], references: [id])
  guest             Guest     @relation(fields: [guestId], references: [id], onDelete: Cascade)
  verifiedBy        User?     @relation("GuestVerifier", fields: [verifiedById], references: [id])

  @@index([guestId])
  @@index([marketId])
  @@index([entryTime])
  @@map("guest_entries")
}

model GateEntry {
  id                String             @id @default(uuid())
  marketId          String
  gateId            String
  vendorId          String
  stallId           String
  entryTime         DateTime
  exitTime          DateTime?
  vehicleNumber     String?            @db.VarChar(50)
  vehicleType       String?            @db.VarChar(50)
  driverName        String?            @db.VarChar(100)
  goodsDescription  String?            @db.VarChar(500)
  quantity          Decimal?           @db.Decimal(12, 2)
  weight            Decimal?           @db.Decimal(10, 2)
  purpose           String?            @db.VarChar(100)
  counterId         String?
  verificationNotes String?
  status            String             @default("ENTERED") @db.VarChar(50)
  metadata          Json?
  createdById       String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  counter           PseudoMarketAdmin? @relation("GateCounter", fields: [counterId], references: [id])
  createdBy         User               @relation(fields: [createdById], references: [id])
  gate              MarketGate         @relation(fields: [gateId], references: [id])
  market            Market             @relation("MarketGateEntries", fields: [marketId], references: [id])
  stall             Stall              @relation(fields: [stallId], references: [id])
  vendor            Vendor             @relation(fields: [vendorId], references: [id])

  @@index([marketId])
  @@index([gateId])
  @@index([vendorId])
  @@index([entryTime])
  @@map("gate_entries")
}

model ShopAsset {
  id          String   @id @default(uuid())
  shopId      String
  assetType   String   @db.VarChar(50)
  assetUrl    String   @db.VarChar(500)
  fileName    String   @db.VarChar(200)
  fileSize    Int
  mimeType    String   @db.VarChar(100)
  description String?
  tags        String[]
  isActive    Boolean  @default(true)
  metadata    Json?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation("ShopAssetCreatedBy", fields: [createdById], references: [id])
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([assetType])
  @@index([isActive])
  @@map("shop_assets")
}

model StallAsset {
  id          String   @id @default(uuid())
  stallId     String
  assetType   String   @db.VarChar(50)
  assetUrl    String   @db.VarChar(500)
  fileName    String   @db.VarChar(200)
  fileSize    Int
  mimeType    String   @db.VarChar(100)
  description String?
  tags        String[]
  isActive    Boolean  @default(true)
  metadata    Json?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation("StallAssetCreatedBy", fields: [createdById], references: [id])
  stall       Stall    @relation(fields: [stallId], references: [id], onDelete: Cascade)

  @@index([stallId])
  @@index([assetType])
  @@index([isActive])
  @@map("stall_assets")
}

model Delivery {
  id                String         @id @default(uuid())
  supplierId        String
  stallId           String
  deliveryDate      DateTime
  expectedDate      DateTime?
  receivedDate      DateTime?
  vehicleNumber     String?        @db.VarChar(50)
  driverName        String?        @db.VarChar(100)
  driverPhone       String?        @db.VarChar(20)
  status            String         @default("PENDING") @db.VarChar(50)
  deliveryStatus    String?        @db.VarChar(50)
  verifiedById      String?
  verificationNotes String?
  metadata          Json?
  createdById       String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  createdBy         User           @relation("DeliveryCreator", fields: [createdById], references: [id])
  supplier          Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  verifiedBy        User?          @relation("DeliveryVerifier", fields: [verifiedById], references: [id])
  deliveryItems     DeliveryItem[]

  @@index([supplierId])
  @@index([stallId])
  @@index([deliveryDate])
  @@index([status])
  @@map("deliveries")
}

